{
  "title": "BindHome",
  "config": {
    "step": {
      "user": {
        "title": "Set up BindHome",
        "description": "Create the BindHome infrastructure registry for this Home Assistant installation."
      }
    },
    "abort": {
      "single_instance_allowed": "BindHome is already configured."
    }
  },
  "services": {
    "create_asset": {
      "name": "Create asset",
      "description": "Create a stable infrastructure asset.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Human-readable asset name."
        },
        "asset_type": {
          "name": "Asset type",
          "description": "Generic lower_snake_case infrastructure type."
        },
        "code": {
          "name": "Code",
          "description": "Optional human-facing asset code."
        },
        "area_id": {
          "name": "Area",
          "description": "Optional Home Assistant area containing the asset."
        },
        "capabilities": {
          "name": "Capabilities",
          "description": "List of lower_snake_case logical capabilities."
        }
      }
    },
    "delete_asset": {
      "name": "Delete asset",
      "description": "Delete an asset that has no relations or active bindings.",
      "fields": {
        "asset_id": {
          "name": "Asset ID",
          "description": "Immutable BindHome asset ID."
        }
      }
    },
    "add_relation": {
      "name": "Add relation",
      "description": "Create a directed topology relation between two assets.",
      "fields": {
        "source_asset_id": {
          "name": "Source asset ID",
          "description": "Source BindHome asset."
        },
        "relation_type": {
          "name": "Relation type",
          "description": "Generic lower_snake_case relation type."
        },
        "target_asset_id": {
          "name": "Target asset ID",
          "description": "Target BindHome asset."
        }
      }
    },
    "remove_relation": {
      "name": "Remove relation",
      "description": "Remove a topology relation.",
      "fields": {
        "relation_id": {
          "name": "Relation ID",
          "description": "BindHome relation ID."
        }
      }
    },
    "set_binding": {
      "name": "Set binding",
      "description": "Bind an asset capability and role to the Home Assistant entity that currently implements it.",
      "fields": {
        "asset_id": {
          "name": "Asset ID",
          "description": "BindHome asset ID."
        },
        "capability": {
          "name": "Capability",
          "description": "Capability provided by the asset."
        },
        "entity_id": {
          "name": "Entity",
          "description": "Current Home Assistant implementation."
        },
        "role": {
          "name": "Role",
          "description": "Binding role, defaulting to primary."
        }
      }
    },
    "remove_binding": {
      "name": "Remove binding",
      "description": "Remove a capability binding without deleting the infrastructure asset.",
      "fields": {
        "binding_id": {
          "name": "Binding ID",
          "description": "BindHome binding ID."
        }
      }
    },
    "get_registry": {
      "name": "Get registry",
      "description": "Return the complete BindHome registry without modifying it."
    }
  },
  "system_health": {
    "info": {
      "loaded": "Loaded",
      "assets": "Assets",
      "relations": "Relations",
      "bindings": "Bindings"
    }
  },
